<?xml version="1.0" encoding="utf-8"?>

<!-- Web.config 轉換說明：https://go.microsoft.com/fwlink/?LinkId=125889 -->
<!--
  Release 組態的 Web.config 轉換檔：發行時移除 compilation 的 debug 屬性。
  連線字串與 appSettings 由 Configuration Builders 以環境變數代入（configBuilders="Env"），此處不轉換這兩個區段，避免覆寫 configBuilders 屬性。
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Release 發行轉換：移除 Web.config 中 compilation 節點的 debug 屬性，避免正式環境以偵錯模式執行。 -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>