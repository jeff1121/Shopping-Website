<?xml version="1.0" encoding="utf-8"?>

<!-- Web.config 轉換說明：https://go.microsoft.com/fwlink/?LinkId=125889 -->
<!--
  Release 組態的 Web.config 轉換檔：發行時移除 compilation 的 debug 屬性、加入 HSTS 標頭，
  並加入 App Service 的追蹤接聽程式。
  連線字串與 appSettings 由 Configuration Builders 以環境變數代入（configBuilders="Env"），此處不轉換這兩個區段，避免覆寫 configBuilders 屬性。
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Release 發行轉換：移除 Web.config 中 compilation 節點的 debug 屬性，避免正式環境以偵錯模式執行。 -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- HSTS：瀏覽器一年內只以 HTTPS 連線本站（未含 includeSubDomains 與 preload） -->
        <add name="Strict-Transport-Security" value="max-age=31536000" xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!--
    App Service 的 Azure Monitor 追蹤接聽程式：把 System.Diagnostics.Trace（啟動錯誤、migration 紀錄）送到
    診斷設定的 AppServiceAppLogs（Log Analytics）。組件只存在於 App Service，因此只在 Release 發行時加入，本機 Debug 不受影響。
  -->
  <system.diagnostics xdt:Transform="Insert">
    <trace autoflush="true">
      <listeners>
        <add name="AzureMonitorTraceListener" type="Microsoft.WindowsAzure.WebSites.Diagnostics.AzureMonitorTraceListener, Microsoft.WindowsAzure.WebSites.Diagnostics, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>