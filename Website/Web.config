<?xml version="1.0" encoding="utf-8"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!-- configBuilders 區段宣告（Configuration Builders 3.x）；必須是 configuration 的第一個子元素。 -->
  <configSections>
    <section name="configBuilders"
      type="System.Configuration.ConfigurationBuildersSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a"
      restartOnExternalChanges="false" requirePermission="false" />
  </configSections>
  <!--
    Env：啟動時把 ${名稱} 權杖替換為同名環境變數（Token 模式）。
    App Service 的應用程式設定（含已解析的 Key Vault 參考）會以環境變數提供；本機請以 setx 設定使用者環境變數（見 QuickStart.md）。
    環境變數未設定時權杖會原樣保留，Global.asax 的啟動檢查（AppSettings.Validate）會列出缺漏的設定名稱。
  -->
  <configBuilders>
    <builders>
      <add name="Env" mode="Token"
        type="Microsoft.Configuration.ConfigurationBuilders.EnvironmentConfigBuilder, Microsoft.Configuration.ConfigurationBuilders.Environment" />
    </builders>
  </configBuilders>
  <!--
    資料庫連線字串：帳號、密碼與伺服器全部來自環境變數，版控中不含任何真實值。
    密碼由權杖直接代入，不可含 ; ' " { } 等字元。
    請勿在 App Service「連線字串」頁籤建立同名項目，否則會在執行階段覆寫此處設定。
  -->
  <connectionStrings configBuilders="Env">
    <!-- 一般請求使用：app 帳號，僅讀寫（db_datareader、db_datawriter）。 -->
    <add name="cmpConnectionString"
      connectionString="Server=${SQL_SERVER};Initial Catalog=${SQL_DATABASE};User ID=${SQL_USER};Password=${SQL_PASSWORD};Encrypt=${SQL_ENCRYPT};TrustServerCertificate=False;Connection Timeout=30;"
      providerName="System.Data.SqlClient" />
    <!-- 僅供啟動時 migration：migrator 帳號，具 DDL 權限（db_ddladmin）。 -->
    <add name="migratorConnectionString"
      connectionString="Server=${SQL_SERVER};Initial Catalog=${SQL_DATABASE};User ID=${SQL_MIGRATOR_USER};Password=${SQL_MIGRATOR_PASSWORD};Encrypt=${SQL_ENCRYPT};TrustServerCertificate=False;Connection Timeout=60;"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <!-- debug="true" 僅適用於開發環境；發行時由 Web.Release.config 轉換移除 -->
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <!-- Azure SDK 等 netstandard2.0 組件需要 netstandard facade，ASP.NET 動態編譯 .aspx 時才找得到型別 -->
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <!-- enableVersionHeader="false"：不送出 X-AspNet-Version 標頭，避免洩漏框架版本 -->
    <httpRuntime targetFramework="4.7.2" enableVersionHeader="false"/>
    <!--
      錯誤頁：遠端使用者只看到 error.aspx 的一般訊息（不顯示例外與堆疊），本機開發仍顯示詳細錯誤。
      ResponseRewrite 保留原網址並回傳正確狀態碼；例外細節由 Global.asax 的 Application_Error 寫入記錄。
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/error.aspx?code=404" />
    </customErrors>
    <!-- Cookie：禁止 JavaScript 讀取，並以 SameSite=Lax 降低跨站請求偽造風險（Secure 旗標由 Web.Release.config 加上） -->
    <httpCookies httpOnlyCookies="true" sameSite="Lax" />
    <sessionState cookieSameSite="Lax" />
  </system.web>
  <!-- 使用 Roslyn（Microsoft.CodeDom.Providers.DotNetCompilerPlatform 4.1.0）編譯頁面與後置程式碼 -->
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701;612;618"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:default /nowarn:41008,40000,40008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
  <!-- 應用程式設定：${名稱} 由 Env builder 代入；集中由 Website.Config.AppSettings 讀取（設定說明見 Plan.md §14.1）。 -->
  <appSettings configBuilders="Env">
    <!-- 關閉 Unobtrusive 驗證，讓 RequiredFieldValidator 等驗證控制項不需 jQuery ScriptResourceMapping -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
    <!-- 寄信（Azure Communication Services Email 的 SMTP 介面，STARTTLS 587） -->
    <add key="SMTP_HOST" value="${SMTP_HOST}" />
    <add key="SMTP_PORT" value="${SMTP_PORT}" />
    <add key="SMTP_USER" value="${SMTP_USER}" />
    <add key="SMTP_PASSWORD" value="${SMTP_PASSWORD}" />
    <add key="SMTP_FROM" value="${SMTP_FROM}" />
    <!-- 商品圖片（Blob Storage 與 Front Door） -->
    <add key="STORAGE_BLOB_ENDPOINT" value="${STORAGE_BLOB_ENDPOINT}" />
    <add key="STORAGE_CONTAINER" value="${STORAGE_CONTAINER}" />
    <add key="IMAGE_BASE_URL" value="${IMAGE_BASE_URL}" />
  </appSettings>
  <!-- 預設文件：讓根網址（/）直接開啟 index.aspx，IIS Express 與 Azure App Service 皆適用 -->
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear/>
        <add value="index.aspx"/>
      </files>
    </defaultDocument>
    <!-- 移除 Server 標頭（IIS 10 以上），避免洩漏伺服器版本 -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <!--
      安全性回應標頭（Plan.md §12 M7 PR D）。HSTS 只在 Web.Release.config 加入，避免本機 localhost 被瀏覽器記住只走 HTTPS。
      CSP 說明：Web Forms 的 __doPostBack、驗證控制項與 Menu 控制項需要內嵌腳本、eval 與內嵌樣式，因此 script-src／style-src 保留
      'unsafe-inline'（script-src 另需 'unsafe-eval'）；商品圖片來自 Front Door（各環境網域不同），因此 img-src 允許 https:。
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- 組件繫結重新導向：Azure SDK 的遞移相依套件版本統一（由 SDK 專案解析 net472 相依閉包產生） -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Azure.Core" publicKeyToken="92742159e12e44c8" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.60.0.0" newVersion="1.60.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Configuration.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.DependencyInjection.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Hosting.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Primitives" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory.Data" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.9" newVersion="10.0.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
