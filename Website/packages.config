<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 套件清單：
  - Roslyn CodeDom 編譯器提供者；訂單 PDF 匯出使用的 iTextSharp 5 與其加密相依套件。
  - Configuration Builders（Environment）：啟動時以環境變數代入 Web.config 的 ${名稱} 權杖。
  - Azure.Storage.Blobs、Azure.Identity：商品圖片上傳至 Blob（受控識別）。
  - dbup-sqlserver：啟動時套用資料庫 migration。
  其餘為上述套件在 net472 下的遞移相依套件；.NET Framework 4.7.2 已內建的 System.Net.Http、System.Runtime、System.ValueTuple 等 facade 不列入。
-->
<packages>
  <package id="Apache.Arrow" version="22.1.0" targetFramework="net472" />
  <package id="Azure.Core" version="1.60.0" targetFramework="net472" />
  <package id="Azure.Identity" version="1.21.0" targetFramework="net472" />
  <package id="Azure.Storage.Blobs" version="12.30.0" targetFramework="net472" />
  <package id="Azure.Storage.Common" version="12.29.0" targetFramework="net472" />
  <package id="BouncyCastle.Cryptography" version="2.6.2" targetFramework="net472" />
  <package id="dbup-core" version="5.0.37" targetFramework="net472" />
  <package id="dbup-sqlserver" version="5.0.41" targetFramework="net472" />
  <package id="iTextSharp" version="5.5.13.6" targetFramework="net472" />
  <package id="Microsoft.Azure.Services.AppAuthentication" version="1.6.2" targetFramework="net472" />
  <package id="Microsoft.Bcl.AsyncInterfaces" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" version="4.1.0" targetFramework="net472" />
  <package id="Microsoft.Configuration.ConfigurationBuilders.Base" version="3.0.0" targetFramework="net472" />
  <package id="Microsoft.Configuration.ConfigurationBuilders.Environment" version="3.0.0" targetFramework="net472" />
  <package id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.Diagnostics.Abstractions" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.FileProviders.Abstractions" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.Logging.Abstractions" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.Options" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Extensions.Primitives" version="10.0.9" targetFramework="net472" />
  <package id="Microsoft.Identity.Client" version="4.84.2" targetFramework="net472" />
  <package id="Microsoft.Identity.Client.Extensions.Msal" version="4.84.2" targetFramework="net472" />
  <package id="Microsoft.IdentityModel.Abstractions" version="8.14.0" targetFramework="net472" />
  <package id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="5.2.9" targetFramework="net472" />
  <package id="System.Buffers" version="4.6.1" targetFramework="net472" />
  <package id="System.ClientModel" version="1.14.0" targetFramework="net472" />
  <package id="System.Diagnostics.DiagnosticSource" version="10.0.9" targetFramework="net472" />
  <package id="System.Formats.Asn1" version="8.0.1" targetFramework="net472" />
  <package id="System.IO.FileSystem.AccessControl" version="5.0.0" targetFramework="net472" />
  <package id="System.IO.Hashing" version="10.0.9" targetFramework="net472" />
  <package id="System.IO.Pipelines" version="10.0.9" targetFramework="net472" />
  <package id="System.Memory" version="4.6.3" targetFramework="net472" />
