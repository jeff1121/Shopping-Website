<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 套件清單：僅有 Roslyn CodeDom 編譯器提供者（供 Web.config 的 system.codedom 使用）。iTextSharp 未透過 NuGet 管理，見 Website.csproj 的 HintPath。 -->
<packages>
  <package id="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" version="2.0.1" targetFramework="net472" />
</packages>