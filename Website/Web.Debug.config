<?xml version="1.0" encoding="utf-8"?>

<!-- Web.config 轉換說明：https://go.microsoft.com/fwlink/?LinkId=125889 -->
<!-- Debug 組態的 Web.config 轉換檔：目前僅含範例註解，沒有實際轉換規則或設定值會被變更。 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    connectionStrings 範例區（目前整段被註解，不會執行）：
    若取消註解，下方 "SetAttributes" 轉換會在找到 name="MyDB" 的連線字串時，
    將 connectionString 屬性改成範例中的 ReleaseSQLServer。
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <!--
      system.web 範例區（目前整段被註解，不會執行）：
      若取消註解，下方 "Replace" 轉換會用範例內容取代 Web.config 的整個 customErrors 區段。
      因 system.web 底下通常只有一個 customErrors 節點，範例不需要 xdt:Locator。
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>