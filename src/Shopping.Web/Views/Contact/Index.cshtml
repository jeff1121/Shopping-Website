@{
    var name = ViewData["Name"] as string ?? "";
    var email = ViewData["Email"] as string ?? "";
    var message = ViewData["Message"] as string ?? "";
}
<h1 class="font-display text-3xl font-bold">@T["ContactTitle"]</h1>
@if (ViewData["Sent"] is true)
{
    <p class="mt-4">@T["ContactSent"]</p>
}
<form class="mt-6 grid max-w-xl gap-4" method="post" action="/contact" novalidate>
    @await Html.PartialAsync("_Token")
    <div asp-validation-summary="All" class="text-red-700"></div>
    <div><label for="name">@T["ContactName"]</label><input class="mt-1 min-h-11 w-full rounded-2xl border border-slate-300 px-4" id="name" name="name" value="@name" /></div>
    <div><label for="email">@T["Email"]</label><input class="mt-1 min-h-11 w-full rounded-2xl border border-slate-300 px-4" id="email" name="email" value="@email" /></div>
    <div><label for="message">@T["ContactMessage"]</label><textarea class="mt-1 min-h-32 w-full rounded-2xl border border-slate-300 px-4 py-3" id="message" name="message">@message</textarea></div>
    <button class="min-h-11 rounded-2xl bg-primary px-4 text-white" type="submit">@T["Submit"]</button>
</form>
